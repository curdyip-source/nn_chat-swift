<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Адрес бэкенда. По умолчанию прод; в Debug-сборке (схема «Local») build-фаза
	     "Set Local API host" подменяет его на http://<IP-твоей-машины>:8001/api/v1.
	     Читается в NufNaf Chat/Core/Config/AppConfig.swift (ключ API_BASE_URL). -->
	<key>API_BASE_URL</key>
	<string>https://chat.nufnafchat.su/api/v1</string>

	<!-- Разрешаем http ТОЛЬКО к локальной сети (LAN/loopback), чтобы приложение на
	     iPhone могло достучаться до локального бэкенда по Wi-Fi. На доступ в интернет
	     это не влияет — там по-прежнему требуется https (прод остаётся строгим). -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
